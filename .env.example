# VerdantNANDA Environment Template
# Duplicate this file to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables.

# Primary Provider Gateway: Mozilla Hosted Otari
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_MODEL=alibaba/qwen3.8-flash
OTARI_API_KEY=

# Secondary Multi-Provider Gateway: Nebius Token Factory
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEBIUS_API_KEY=
