{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/gateway/:path*",
      "destination": "/api/gateway"
    },
    {
      "source": "/api/gateway",
      "destination": "/api/gateway"
    },
    {
      "source": "/sdk",
      "destination": "/sdk/index.html"
    },
    {
      "source": "/sdk/",
      "destination": "/sdk/index.html"
    },
    {
      "source": "/sdk/:path*",
      "destination": "/sdk/:path*"
    },
    {
      "source": "/partners/pineridge-stays",
      "destination": "/partners/pineridge-stays/index.html"
    },
    {
      "source": "/partners/pineridge-stays/",
      "destination": "/partners/pineridge-stays/index.html"
    },
    {
      "source": "/partners/pineridge-stays/:path*",
      "destination": "/partners/pineridge-stays/:path*"
    },
    {
      "source": "/partners/emeraldfjord-tours",
      "destination": "/partners/emeraldfjord-tours/index.html"
    },
    {
      "source": "/partners/emeraldfjord-tours/",
      "destination": "/partners/emeraldfjord-tours/index.html"
    },
    {
      "source": "/partners/emeraldfjord-tours/:path*",
      "destination": "/partners/emeraldfjord-tours/:path*"
    },
    {
      "source": "/nanda",
      "destination": "/nanda/nanda-index.json"
    },
    {
      "source": "/nanda/",
      "destination": "/nanda/nanda-index.json"
    },
    {
      "source": "/nanda/:path*",
      "destination": "/nanda/:path*"
    },
    {
      "source": "/styles.css",
      "destination": "/hub/styles.css"
    },
    {
      "source": "/site.js",
      "destination": "/hub/site.js"
    },
    {
      "source": "/site-actions.js",
      "destination": "/hub/site-actions.js"
    },
    {
      "source": "/agent-manifest.json",
      "destination": "/hub/agent-manifest.json"
    },
    {
      "source": "/agent-mcp.json",
      "destination": "/hub/agent-mcp.json"
    },
    {
      "source": "/links.json",
      "destination": "/hub/links.json"
    },
    {
      "source": "/concierge_negotiator.hocon",
      "destination": "/hub/concierge_negotiator.hocon"
    },
    {
      "source": "/concierge_negotiator.network.json",
      "destination": "/hub/concierge_negotiator.network.json"
    },
    {
      "source": "/.network.json",
      "destination": "/hub/concierge_negotiator.network.json"
    },
    {
      "source": "/favicon.ico",
      "destination": "/hub/favicon.ico"
    },
    {
      "source": "/js/:path*",
      "destination": "/hub/js/:path*"
    },
    {
      "source": "/runtime/:path*",
      "destination": "/hub/runtime/:path*"
    },
    {
      "source": "/bridge/:path*",
      "destination": "/hub/bridge/:path*"
    },
    {
      "source": "/tests/:path*",
      "destination": "/hub/tests/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/hub/.well-known/:path*"
    },
    {
      "source": "/hub",
      "destination": "/hub/index.html"
    },
    {
      "source": "/hub/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/hub/:path*",
      "destination": "/hub/:path*"
    },
    {
      "source": "/",
      "destination": "/hub/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|mjs)",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Provider, X-Nsdeploy-Route" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Provider, X-Nsdeploy-Route" }
      ]
    },
    {
      "source": "/(.*)\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Provider, X-Nsdeploy-Route" }
      ]
    },
    {
      "source": "/(.*)\\.network\\.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Provider, X-Nsdeploy-Route" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Provider, X-Nsdeploy-Route" }
      ]
    }
  ]
}
